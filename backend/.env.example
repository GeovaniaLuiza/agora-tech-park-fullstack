PORT=3002
CLIENT_URL=http://localhost:5174
# Example DATABASE_URL (do not commit real passwords)
# Format: postgresql://usuario:senha@localhost:5435/database
DATABASE_URL=postgresql://usuario:senha@localhost:5435/agora_indicadores

# Connection pool tuning (development defaults)
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000

# Observability (generate a different high-entropy token in production)
LOG_LEVEL=info
METRICS_TOKEN=troque-este-token-em-producao
HEALTH_CACHE_TTL_MS=15000
HEALTH_CHECK_TIMEOUT_MS=3000

JWT_SECRET=troque-esta-chave-segura-em-producao
JWT_EXPIRES_IN=8h
NODE_ENV=development
TRUST_PROXY_HOPS=0
GLOBAL_RATE_LIMIT_WINDOW_MS=900000
GLOBAL_RATE_LIMIT_MAX=500
LOGIN_RATE_LIMIT_WINDOW_MS=60000
LOGIN_RATE_LIMIT_MAX=30
REGISTER_RATE_LIMIT_WINDOW_MS=60000
REGISTER_RATE_LIMIT_MAX=20
RESEND_RATE_LIMIT_WINDOW_MS=60000
RESEND_RATE_LIMIT_MAX=10
RESEND_COOLDOWN_RATE_LIMIT_WINDOW_MS=300000
RESEND_COOLDOWN_RATE_LIMIT_MAX=1
RESEND_EMAIL_RATE_LIMIT_WINDOW_MS=3600000
RESEND_EMAIL_RATE_LIMIT_MAX=5
VERIFY_RATE_LIMIT_WINDOW_MS=60000
VERIFY_RATE_LIMIT_MAX=30
FRONTEND_URL=http://localhost:5174
EMAIL_PROVIDER=smtp
# Use localhost quando o backend roda na máquina; use mailpit dentro do Docker Compose.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_CONNECTION_TIMEOUT_MS=10000
EMAIL_FROM="Ágora Tech Park <nao-responda@agoratechpark.com.br>"
EMAIL_FROM_NAME="Ágora Tech Park"
EMAIL_FROM_ADDRESS=nao-responda@agoratechpark.com.br
EMAIL_VERIFICATION_TTL_HOURS=24
EMAIL_VERIFICATION_TOKEN_TTL_HOURS=24
EMAIL_RESEND_MINUTES=5
EMAIL_RESEND_MAX_PER_HOUR=5
PASSWORD_RESET_TOKEN_TTL_HOURS=1
FORGOT_PASSWORD_RATE_LIMIT_WINDOW_MS=3600000
FORGOT_PASSWORD_RATE_LIMIT_MAX=5
