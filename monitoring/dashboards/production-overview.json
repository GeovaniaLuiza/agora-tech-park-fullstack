{
  "annotations": { "list": [] }, "editable": true, "graphTooltip": 1,
  "panels": [
    { "type": "stat", "title": "API up/down", "id": 1, "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "targets": [{ "refId": "A", "expr": "max(up{job=~\".*agora_api.*\"})" }], "fieldConfig": { "defaults": { "mappings": [{ "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }], "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] } }, "overrides": [] }, "gridPos": { "h": 8, "w": 6, "x": 0, "y": 0 } },
    { "type": "timeseries", "title": "Requests por minuto", "id": 2, "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "targets": [{ "refId": "A", "expr": "60 * sum(rate(agora_http_requests_total[5m]))" }], "fieldConfig": { "defaults": { "unit": "reqpm" }, "overrides": [] }, "gridPos": { "h": 8, "w": 9, "x": 6, "y": 0 } },
    { "type": "timeseries", "title": "Erros HTTP 5xx", "id": 3, "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "targets": [{ "refId": "A", "expr": "sum(rate(agora_http_requests_total{status_code=~\"5..\"}[5m]))" }], "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] }, "gridPos": { "h": 8, "w": 9, "x": 15, "y": 0 } },
    { "type": "timeseries", "title": "Latência da API", "id": 4, "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "targets": [{ "refId": "A", "expr": "sum(rate(agora_http_request_duration_seconds_sum[5m])) / clamp_min(sum(rate(agora_http_request_duration_seconds_count[5m])), 0.001)", "legendFormat": "média" }, { "refId": "B", "expr": "histogram_quantile(0.95, sum by (le) (rate(agora_http_request_duration_seconds_bucket[5m])))", "legendFormat": "p95" }], "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] }, "gridPos": { "h": 8, "w": 24, "x": 0, "y": 8 } },
    { "type": "timeseries", "title": "CPU do processo Node", "id": 5, "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "targets": [{ "refId": "A", "expr": "rate(agora_process_process_cpu_seconds_total{service=\"agora-api\"}[5m]) * 100" }], "fieldConfig": { "defaults": { "unit": "percent", "min": 0 }, "overrides": [] }, "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 } },
    { "type": "timeseries", "title": "Memória RSS do processo Node", "id": 6, "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "targets": [{ "refId": "A", "expr": "agora_process_process_resident_memory_bytes{service=\"agora-api\"}" }], "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] }, "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 } },
    { "type": "stat", "title": "PostgreSQL up/down", "id": 7, "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "targets": [{ "refId": "A", "expr": "agora_database_up" }], "fieldConfig": { "defaults": { "mappings": [{ "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }], "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] } }, "overrides": [] }, "gridPos": { "h": 8, "w": 6, "x": 0, "y": 24 } },
    { "type": "timeseries", "title": "Conexões PostgreSQL", "id": 8, "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "targets": [{ "refId": "A", "expr": "agora_database_connections", "legendFormat": "{{state}}" }], "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] }, "gridPos": { "h": 8, "w": 18, "x": 6, "y": 24 } },
    { "type": "logs", "title": "Logs recentes da API", "id": 9, "datasource": { "type": "loki", "uid": "${DS_LOKI}" }, "targets": [{ "refId": "A", "expr": "{service=\"agora-api\"}", "queryType": "range" }], "gridPos": { "h": 10, "w": 12, "x": 0, "y": 32 } },
    { "type": "timeseries", "title": "Erros nos logs (5 min)", "id": 10, "datasource": { "type": "loki", "uid": "${DS_LOKI}" }, "targets": [{ "refId": "A", "expr": "sum(count_over_time({service=\"agora-api\"} | json | level >= 50 [5m])) or on() vector(0)", "queryType": "range" }], "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] }, "gridPos": { "h": 10, "w": 12, "x": 12, "y": 32 } }
  ],
  "refresh": "1m", "schemaVersion": 41, "tags": ["agora", "production", "overview"],
  "templating": { "list": [{ "name": "DS_PROMETHEUS", "type": "datasource", "query": "prometheus", "label": "Prometheus" }, { "name": "DS_LOKI", "type": "datasource", "query": "loki", "label": "Loki" }] },
  "time": { "from": "now-6h", "to": "now" }, "title": "Agora Tech Park - Production Overview", "uid": "agora-production-overview", "version": 1
}
